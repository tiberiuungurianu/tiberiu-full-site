{
  // Production Worker → tiberiu.online
  "name": "tiberiu-full-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Pre-prod: npm run deploy:ppd  (branch PPD-changes)
  "env": {
    "ppd": {
      "name": "tiberiu-full-site-ppd",
      "workers_dev": true,
      "routes": [
        { "pattern": "ppd.tiberiu.online", "custom_domain": true }
      ],
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
