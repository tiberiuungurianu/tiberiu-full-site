{
  // Production → tiberiu.online / www only (no wildcard — that would steal ppd.*)
  "name": "tiberiu-full-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "routes": [
    { "pattern": "tiberiu.online", "custom_domain": true },
    { "pattern": "www.tiberiu.online", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Pre-prod (branch PPD-changes): npm run deploy:ppd
  "env": {
    "ppd": {
      "name": "tiberiu-full-site-ppd",
      "workers_dev": true,
      "routes": [
        { "pattern": "ppd.tiberiu.online", "custom_domain": true }
      ],
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
